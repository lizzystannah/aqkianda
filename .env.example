# ==============================================================
# Aqkianda Marketplace — Arquitetura de Domínio & URL Base Centralizado
# ==============================================================
# Em fase de testes ou staging na tua VPS, podes colocar o link temporário:
# APP_URL=https://link-generico-da-tua-vps.com
# VITE_APP_URL=https://link-generico-da-tua-vps.com
#
# Futuramente, quando comprares o teu domínio próprio, basta alterar apenas aqui:
# APP_URL=https://meudominio.com
# VITE_APP_URL=https://meudominio.com
# O restante da aplicação, sitemaps, links de partilha e SEO adaptam-se automaticamente!
APP_URL=
VITE_APP_URL=

# ==============================================================
# Aqkianda Marketplace — Email de Root / Administrador do Sistema
# ==============================================================
# Define o e-mail (ou múltiplos e-mails separados por vírgula) que terão acesso
# total de Administrador / Root ao painel /admin e permissões de gestão do sistema:
ADMIN_EMAIL=admin@teudominio.com
# Também podes usar o alias ROOT_EMAIL se preferires:
# ROOT_EMAIL=admin@teudominio.com

# ==============================================================
# Aqkianda Marketplace — Configuração da Base de Dados MySQL
# ==============================================================
# Define as tuas variáveis de ambiente no teu ficheiro .env ou docker-compose:
DB_HOST=quantterm_mysql
DB_PORT=3306
DB_USER=mysql
DB_PASSWORD=a_tua_palavra_passe

# Define aqui o nome exato da base de dados que criaste no teu MySQL:
DB_NAME=o_nome_da_tua_base_de_dados
# Também podes usar o alias MYSQL_DATABASE se preferires:
# MYSQL_DATABASE=o_nome_da_tua_base_de_dados
